+/*
+ * ishtar: one byte, not PAGE_MAX_SIZE. In the arm64e fileset __DATA_CONST is its own page-aligned segment, so the
+ * separator page is not needed, and the iPhone17,2 kernelcache leaves the native constants no room for it: Apple's
+ * kernel has 0xdc000 + 0x4000 before the first retained kext constants (AppleARMPlatform), ours needed 0x120000 + 0x4000.
+ */
+#define PAD_SIZE        1
