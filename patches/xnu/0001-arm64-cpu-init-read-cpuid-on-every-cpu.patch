diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 45cc0d2..9432150 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -708,6 +708,14 @@ cpu_init(void)
 			 * dealt with as part of pmap_bootstrap.
 			 */
 			pmap_cpu_data_init();
+			/*
+			 * Only the boot CPU runs do_cpuid(), so on every other CPU
+			 * the architecture stays unknown and the switch below panics
+			 * with "Unknown CPU subtype...". That panic happens before the
+			 * console exists, so the boot just hangs. Read the MIDR for
+			 * every CPU and let the switch below pick the subtype.
+			 */
+			do_cpuid();
 		}
 
 		do_cacheid();
