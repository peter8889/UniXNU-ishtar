From ca8ac0b3649f390822571371b6457d52eebd6d60 Mon Sep 17 00:00:00 2001
From: Akash Srivastava <akashniki@gmail.com>
Date: Thu, 29 Oct 2026 13:24:13 +0100
Subject: [PATCH 1/3] profiles: ios-27.0.1-24A446 (iPhone17,2 D94AP)

Same build, kernel source and OS series as ipados-27.0.1-24A446. iPhone17,2
IPSW, kernelcache pin, prelink roots (no IOHIDEventDriver bundle on iPhone),
D94AP identity. AMFI init address and root volume UUIDs are REQUIRED values.
---
 .../os/ios-27.0.1-24A446/configs/ios.config   |   2 +
 .../os/ios-27.0.1-24A446/patches/xnu/series   |   6 +
 profiles/os/ios-27.0.1-24A446/profile.toml    | 163 ++++++++++++++++++
 3 files changed, 171 insertions(+)
 create mode 100644 profiles/os/ios-27.0.1-24A446/configs/ios.config
 create mode 100644 profiles/os/ios-27.0.1-24A446/patches/xnu/series
 create mode 100644 profiles/os/ios-27.0.1-24A446/profile.toml

diff --git a/profiles/os/ios-27.0.1-24A446/configs/ios.config b/profiles/os/ios-27.0.1-24A446/configs/ios.config
new file mode 100644
index 0000000..4ee9042
--- /dev/null
+++ b/profiles/os/ios-27.0.1-24A446/configs/ios.config
@@ -0,0 +1,2 @@
+CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
+CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
diff --git a/profiles/os/ios-27.0.1-24A446/patches/xnu/series b/profiles/os/ios-27.0.1-24A446/patches/xnu/series
new file mode 100644
index 0000000..9acf0c6
--- /dev/null
+++ b/profiles/os/ios-27.0.1-24A446/patches/xnu/series
@@ -0,0 +1,6 @@
+# OS patch paths for xnu-12377.121.6, one per line in application order.
+# No Darwin 26 XNU source is published yet; 24A446 runs on xnu-12377 with the Darwin 26 system calls and KPIs added.
+arch:../../../patches/xnu-12377/zzz-boot-progress.patch
+arch:../../../patches/xnu-12377/darwin26-syscalls.patch
+arch:../../../patches/xnu-12377/darwin26-kpi.patch
+arch:../../../patches/xnu-12377/darwin26-shared-region.patch
diff --git a/profiles/os/ios-27.0.1-24A446/profile.toml b/profiles/os/ios-27.0.1-24A446/profile.toml
new file mode 100644
index 0000000..a355759
--- /dev/null
+++ b/profiles/os/ios-27.0.1-24A446/profile.toml
@@ -0,0 +1,163 @@
+["os"]
+"name" = "ios-27.0.1-24A446"
+"arch" = "arm64e"
+"darwin" = "25.5.0"
+# Same build as ipados-27.0.1-24A446: every iOS 27.0.1 iPhone and iPad ships 24A446, so the kernel source, the Darwin 26
+# system-call patches and the OS patch series are shared. Only the IPSW, the original kexts and the identity differ.
+# The iPhone17,2 kernelcache reports xnu-13432.2.10~2/RELEASE_ARM64_T8140 (Darwin 27.0.0); 12377.121.6 is the newest
+# public source, as for the iPad profile.
+"xnu_version" = "12377.121.6"
+"xnu_revision" = "ac9718fb1af618d5ce8678d0dc6e8a58f252216f"
+"driverkit_tag" = "xnu-12377.121.6"
+"trustcache_tag" = "xnu-8796.101.5"
+"ios_version" = "27.0"
+"abi" = []
+
+
+["ipsw"]
+# iPhone 16 Pro Max. 12314041166 bytes, IPSW sha256 2b846dfd495f17eb074dacc6d892529df7f18587afdf930645747cd42286f538 (ipsw.me).
+"url" = "https://updates.cdn-apple.com/2026FallFCS/3741bcd4-e0a6-43a7-bac1-74f363efb9ab/iPhone17,2_27.0.1_24A446_Restore.ipsw"
+"product" = "iPhone17,2"
+"version" = "27.0.1"
+"build" = "24A446"
+"device_class" = "d94ap"
+"chip_id" = 33088
+"board_id" = 14
+"fetch" = ["KernelCache", "DeviceTree", "StaticTrustCache", "Cryptex1,SystemTrustCache"]
+
+
+["kernel"]
+
+["kernel"."prelink"]
+"tool" = "kits/XnuPrelink/emit_prelink.py"
+"kernel" = "build/xnu/ios-obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837.unstripped.noctf"
+# sha256 of the decompressed arm64e Mach-O (kernelcache.release.iphone17, MH_FILESET, 305 entries).
+"kernelcache_sha256" = "fa07057bf34f33af1ec26681ad0c87c13e5aaa548a300740eddb0e92876e5f95"
+"slide" = "-0x1000000"
+# REQUIRED: the iPhone17,2 address of the AMFI wrapper that calls _initializeAppleMobileFileIntegrity and returns 0
+# (the iPad17,3 one is 0xfffffe00092551ac). Locate it in this kernelcache before the first prelink.
+"early_security_init" = "com.apple.driver.AppleMobileFileIntegrity=REQUIRED_IPHONE17_2_ADDRESS"
+"extra_args" = ["--fileset-reference", "build/xnu/fileset-reference/mach.release.bcm2837.unstripped.noctf", "--allow-missing"]
+# The iPad roots minus com.apple.iokit.IOHIDEventDriver, which the iPhone17,2 fileset does not have (the class itself
+# ships in IOHIDFamily). Every other root is present.
+"roots" = ["com.apple.AppleFSCompression.AppleFSCompressionTypeZlib", "com.apple.driver.AppleARMPlatform", "com.apple.driver.AppleARMWatchdogTimer", "com.apple.driver.AppleAudioClockLibs", "com.apple.driver.AppleEffaceableStorage", "com.apple.driver.AppleIISController", "com.apple.driver.AppleM2ScalerCSCDriver", "com.apple.driver.AppleMobileFileIntegrity", "com.apple.driver.ApplePMGR", "com.apple.driver.IODARTFamily", "com.apple.filesystems.apfs", "com.apple.iokit.CoreAnalyticsFamily", "com.apple.iokit.IOAVFamily", "com.apple.iokit.IOAudio2Family", "com.apple.iokit.IOCECFamily", "com.apple.iokit.IOCryptoAcceleratorFamily", "com.apple.iokit.IOGPUFamily", "com.apple.iokit.IOHDCPFamily", "com.apple.iokit.IOMobileGraphicsFamily", "com.apple.iokit.IOReportFamily", "com.apple.iokit.IOSlowAdaptiveClockingFamily", "com.apple.iokit.IOStorageFamily", "com.apple.iokit.IOSurface", "com.apple.kec.Libm", "com.apple.kec.corecrypto", "com.apple.kext.AppleMatch", "com.apple.kext.CoreTrust", "com.apple.security.AppleImage4", "com.apple.security.sandbox", "com.apple.iokit.IOHIDFamily"]
+
+
+["adt"]
+
+["adt"."root"]
+
+["adt"."root"."string"]
+"model" = "iPhone17,2"
+"target-type" = "D94"
+"target-sub-type" = "D94AP"
+"compatible" = "D94AP"
+
+
+["adt"."chosen"]
+
+["adt"."chosen"."string"]
+"osenvironment" = "main"
+"crypto-hash-method" = "sha2-384"
+
+
+["adt"."chosen"."u32"]
+"certificate-production-status" = 0
+"effective-production-status-ap" = 0
+"certificate-security-mode" = 1
+"effective-security-mode-sep" = 1
+"amfi-only-platform-code" = 1
+
+
+# Identity values of the D94AP device tree (Firmware/all_flash/DeviceTree.d94ap.im4p) that SpringBoard and UIKit read.
+# Hardware claims of the real phone (baseband, exclaves, cameras, NFC, Wi-Fi chipset, Apple LPM) are left out on purpose;
+# boards add their own (artwork-display-gamut, buttons, defaults).
+["adt"."product"]
+
+["adt"."product"."string"]
+"product-name" = "iPhone 16 Pro Max"
+"product-description" = "iPhone 16 Pro Max"
+"unique-model" = "D94AP"
+"sub-product-type" = "iPhone17,2"
+"fdr-product-type" = "iPhone17,2"
+"compatible-device-fallback" = "iPhone16,2"
+"partition-style" = "iOS"
+"app-macho-architecture" = "arm64e"
+"artwork-device-idiom" = "phone"
+"artwork-dynamic-displaymode" = "0"
+"chrome-identifier" = "com.apple.dt.devicekit.chrome.phone12"
+"graphics-featureset-class" = "APPLE9"
+"graphics-featureset-fallbacks" = "APPLE8:APPLE7:APPLE6:APPLE5:APPLE4:APPLE3:APPLE3v1:APPLE2:APPLE1:GLES2,0"
+
+
+["adt"."product"."u32"]
+# 1320x2868 pixels, 440x956 points at @3x.
+"artwork-device-subtype" = 2868
+"artwork-scale-factor" = 3
+"island-notch-location" = 144
+"oled-display" = 1
+"thin-bezel" = 1
+"large-format-phone" = 1
+"ui-reachability" = 1
+
+
+["adt"."product"."bytes"]
+"display-corner-radius" = "3e00000001000000"
+
+
+# Apple sources of the macOS 26.5 release that pairs with xnu-12377.121.6 (same pins as ipados-27.0.1-24A446).
+[[source]]
+name = "IOStorageFamily"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/IOStorageFamily.git"
+ref = "IOStorageFamily-337.100.1"
+commit = "7edb88fbae296fb7c8ce2f64e115e116e566d51c"
+
+[[source]]
+name = "IOHIDFamily"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/IOHIDFamily.git"
+ref = "IOHIDFamily-2238.120.5"
+commit = "e31e90a24c27ad6cbe981650d12a1a4124065b03"
+
+[[source]]
+name = "libplatform"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/libplatform.git"
+ref = "libplatform-375.120.2"
+commit = "b7ed7cf5cf7dd12b98672435db2225a860f199d8"
+
+[[source]]
+name = "libdispatch"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/libdispatch.git"
+ref = "libdispatch-1542.100.32"
+commit = "701f4d1a24ae9c6863901bbbb22624b7d1b87321"
+
+[[source]]
+name = "AvailabilityVersions"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/AvailabilityVersions.git"
+ref = "AvailabilityVersions-157.2"
+commit = "149b1777f3e8c2133042d8e188f72e3adf6a7110"
+
+[[source]]
+name = "libpthread"
+kind = "refer"
+git = "https://github.com/apple-oss-distributions/libpthread.git"
+ref = "libpthread-539.100.4"
+commit = "1f4f5265b319111142f1bf3a27d4484ef5a98314"
+
+[userdata]
+windows = [{ name = "OS", component = "OS" }, { name = "SystemOS", component = "Cryptex1,SystemOS", optional = true }]
+
+[root]
+# REQUIRED: APFS volume UUIDs and digests of the decrypted iPhone17,2 images (OS = 043-69909-664.dmg.aea,
+# Cryptex1,SystemOS = 043-68526-711.dmg.aea). Decrypting needs `ipsw fw aea --key` + /usr/bin/aea (unixnu ipsw.decrypt_aea).
+os_volume_uuid = "REQUIRED_OS_VOLUME_UUID"
+os_image_sha256 = "REQUIRED_OS_IMAGE_SHA256"
+systemos_volume_uuid = "REQUIRED_SYSTEMOS_VOLUME_UUID"
+systemos_image_sha256 = "REQUIRED_SYSTEMOS_IMAGE_SHA256"
+
+[payload.adt]
+root_match_volume_uuid = "REQUIRED_OS_VOLUME_UUID"
-- 
