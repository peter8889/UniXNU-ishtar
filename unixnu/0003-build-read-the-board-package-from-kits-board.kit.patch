From a22714b7780e6f2fdd7de702d63a216aa3e1564b Mon Sep 17 00:00:00 2001
From: Akash Srivastava <akashniki@gmail.com>
Date: Thu, 29 Oct 2026 16:43:30 +0100
Subject: [PATCH 3/5] build: read the board package from kits/<board.kit>

kernel.py exports UNIXNU_BOARD_KIT; build-sheng-source-storage.py and
build-arm-driver.py (NativeAdreno) use it instead of the fixed kits/sheng.
The default stays sheng, so sheng builds are unchanged.
---
 scripts/build-arm-driver.py           | 3 ++-
 scripts/build-sheng-source-storage.py | 7 ++++---
 scripts/unixnu/kernel.py              | 1 +
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/scripts/build-arm-driver.py b/scripts/build-arm-driver.py
index b027a9b..2a9c354 100644
--- a/scripts/build-arm-driver.py
+++ b/scripts/build-arm-driver.py
@@ -2,6 +2,7 @@
 """Compile the generic platform expert against the actual source-kernel ABI."""
 import argparse
 import json
+import os
 import tomllib
 from pathlib import Path
 import subprocess
@@ -102,7 +103,7 @@ if component in ('NativeLegacyDisplay','NativeHidInput'):
     command += ['-I', str(out)]
 if component == 'NativeAdreno':
     command += ['-I', str(ROOT / 'kits/ArmSmmu4K'), '-I', str(ROOT / 'kits/AdrenoPM4'),
-                '-I', str(ROOT / 'kits/sheng'), '-I', str(ROOT / 'kits/Sm8550Platform'), '-I', str(ROOT / 'kits/AdrenoFirmware'),
+                '-I', str(ROOT / 'kits' / os.environ.get('UNIXNU_BOARD_KIT', 'sheng')), '-I', str(ROOT / 'kits/Sm8550Platform'), '-I', str(ROOT / 'kits/AdrenoFirmware'),
                 '-I', str(ROOT / 'build/sheng-gmu'), '-I', str(ROOT / 'build/adreno740/include')]
 (out / 'compile-command.json').write_text(json.dumps(command, indent=2) + '\n')
 result = subprocess.run(command, cwd=record['directory'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
diff --git a/scripts/build-sheng-source-storage.py b/scripts/build-sheng-source-storage.py
index de2033c..8c82e64 100644
--- a/scripts/build-sheng-source-storage.py
+++ b/scripts/build-sheng-source-storage.py
@@ -77,13 +77,14 @@ def main():
     if not build_id:
         parser.error('UNIXNU_IPSW_BUILD is not set; run through unixnu build kernel')
     policies = (args.policy_dir or tree / f'build/verified-root-{build_id}').resolve()
-    # The resolved build tree links the device package as kits/sheng, while an
+    # The resolved build tree links the device package as kits/<board.kit>, while an
     # explicit device repository keeps package/ and drivers/ side by side.
+    kit = os.environ.get('UNIXNU_BOARD_KIT', 'sheng')
     package_dirs = [device / 'package']
     if device != tree:
-        package_dirs += [device / 'kits/sheng', tree / 'kits/sheng']
+        package_dirs += [device / 'kits' / kit, tree / 'kits' / kit]
     else:
-        package_dirs += [tree / 'kits/sheng']
+        package_dirs += [tree / 'kits' / kit]
 
     def device_source(relative, *extra):
         for directory in list(extra) + package_dirs + [device, tree]:
diff --git a/scripts/unixnu/kernel.py b/scripts/unixnu/kernel.py
index 49aea5a..15ab67c 100644
--- a/scripts/unixnu/kernel.py
+++ b/scripts/unixnu/kernel.py
@@ -65,6 +65,7 @@ def version_env(modules, ctx=None):
         if root.get('systemos_volume_uuid'):
             env['UNIXNU_ROOT_SYSTEMOS_UUID'] = root['systemos_volume_uuid']
         env['UNIXNU_IPSW_BUILD'] = ctx.board.get('ipsw', {}).get('build', '')
+        env['UNIXNU_BOARD_KIT'] = ctx.board.get('board', {}).get('kit', ctx.name)
         env['UNIXNU_XNU_ARCH'] = load_toml(ctx.profile_roots['arch'] / 'profile.toml').get('arch', {}).get('name', 'arm64')
     return env
 
