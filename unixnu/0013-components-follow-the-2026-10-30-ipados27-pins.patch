@@ -211,7 +211,7 @@ kind = "driver"
 function = "UEFI GOP framebuffer and MobileFramebuffer integration"
 scope = "display"
 repository = "https://github.com/UniXNU/GopFramebuffer.git"
-revision = "90b64efcdbf43edbc40a66f14bdb8a97a07a12ae"
+revision = "4975bc84eb87e16d629125dcffb30cc30dfd2d86"
