From 0e1685968ac40f74f8c0a91dea909773322fea88 Mon Sep 17 00:00:00 2001
From: Akash Srivastava <akashniki@gmail.com>
Date: Thu, 29 Oct 2026 23:07:22 +0100
Subject: [PATCH 6/9] build: iPhone17,2 prelink without the RELEASE reference;
 entry probe fixes for fileset kernels

- profile: drop --fileset-reference (nothing builds that RELEASE kernel; it
  only adds names to unique code matches), keep --allow-missing.
- patch-xnu-entry-probe.py: skip llvm-nm's 'Symbols for <entry>:' headers;
  start the panic screen right after the last probe's code, not a whole cave
  later; prefer Homebrew LLVM clang (Apple clang's code is 7 bytes too big).

Change-Id: I3a9e485b1e97b21da0c762ba12d5f81c799e7f61
---
 profiles/os/ios-27.0.1-24A446/profile.toml |  4 +++-
 scripts/patch-xnu-entry-probe.py           | 12 ++++++++----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/profiles/os/ios-27.0.1-24A446/profile.toml b/profiles/os/ios-27.0.1-24A446/profile.toml
index 8108ac2..43d2014 100644
--- a/profiles/os/ios-27.0.1-24A446/profile.toml
+++ b/profiles/os/ios-27.0.1-24A446/profile.toml
@@ -37,7 +37,9 @@
 # The AMFI wrapper that calls _initializeAppleMobileFileIntegrity and returns 0: iPad17,3 0xfffffe00092551ac ported to
 # this kernelcache (AppleMobileFileIntegrity __TEXT_EXEC+0xe7ec, masked code verified; UniXNU-ishtar scripts/kc-port.py).
 "early_security_init" = "com.apple.driver.AppleMobileFileIntegrity=0xfffffff00921000c"
-"extra_args" = ["--fileset-reference", "build/xnu/fileset-reference/mach.release.bcm2837.unstripped.noctf", "--allow-missing"]
+# No --fileset-reference: nothing in UniXNU builds the RELEASE comparison kernel the iPad profile names. It only adds
+# symbol names to unique code matches; --allow-missing lists what stays unresolved in the prelink report.
+"extra_args" = ["--allow-missing"]
 # The iPad roots minus com.apple.iokit.IOHIDEventDriver, which the iPhone17,2 fileset does not have (the class itself
 # ships in IOHIDFamily). Every other root is present.
 "roots" = ["com.apple.AppleFSCompression.AppleFSCompressionTypeZlib", "com.apple.driver.AppleARMPlatform", "com.apple.driver.AppleARMWatchdogTimer", "com.apple.driver.AppleAudioClockLibs", "com.apple.driver.AppleEffaceableStorage", "com.apple.driver.AppleIISController", "com.apple.driver.AppleM2ScalerCSCDriver", "com.apple.driver.AppleMobileFileIntegrity", "com.apple.driver.ApplePMGR", "com.apple.driver.IODARTFamily", "com.apple.filesystems.apfs", "com.apple.iokit.CoreAnalyticsFamily", "com.apple.iokit.IOAVFamily", "com.apple.iokit.IOAudio2Family", "com.apple.iokit.IOCECFamily", "com.apple.iokit.IOCryptoAcceleratorFamily", "com.apple.iokit.IOGPUFamily", "com.apple.iokit.IOHDCPFamily", "com.apple.iokit.IOMobileGraphicsFamily", "com.apple.iokit.IOReportFamily", "com.apple.iokit.IOSlowAdaptiveClockingFamily", "com.apple.iokit.IOStorageFamily", "com.apple.iokit.IOSurface", "com.apple.kec.Libm", "com.apple.kec.corecrypto", "com.apple.kext.AppleMatch", "com.apple.kext.CoreTrust", "com.apple.security.AppleImage4", "com.apple.security.sandbox", "com.apple.iokit.IOHIDFamily"]
diff --git a/scripts/patch-xnu-entry-probe.py b/scripts/patch-xnu-entry-probe.py
index 9e3e598..e54d5e9 100644
--- a/scripts/patch-xnu-entry-probe.py
+++ b/scripts/patch-xnu-entry-probe.py
@@ -139,7 +139,8 @@ def kernel_symbols(kernel):
     table = {}
     for line in subprocess.run([nm, '-n', kernel], capture_output=True, text=True, check=True).stdout.splitlines():
         parts = line.split()
-        if len(parts) == 3:
+        # A fileset kernel's listing has a "Symbols for <entry>:" header per entry (llvm-nm 23).
+        if len(parts) == 3 and all(c in '0123456789abcdefABCDEF' for c in parts[0]):
             table.setdefault(int(parts[0], 16), parts[2])
     return table
 
@@ -175,7 +176,8 @@ def assemble_c(source, va, workdir, symbols):
 
     The linker may start .text a little after VA (it keeps the ELF headers in front), so the
     load address is read back from the ELF and is what the caller must write the bytes to."""
-    clang = shutil.which('clang') or '/opt/homebrew/opt/llvm/bin/clang'
+    # LLVM's clang first: macOS puts Apple clang on PATH, and its panic-screen code is a few bytes larger than the cave.
+    clang = next((c for c in ('/opt/homebrew/opt/llvm/bin/clang', shutil.which('clang')) if c and Path(c).is_file()), 'clang')
     lld = shutil.which('ld.lld') or '/opt/homebrew/opt/llvm/bin/ld.lld'
     objcopy = shutil.which('llvm-objcopy') or '/opt/homebrew/opt/llvm/bin/llvm-objcopy'
     nm = shutil.which('llvm-nm') or '/opt/homebrew/opt/llvm/bin/llvm-nm'
@@ -344,7 +346,7 @@ def branch(from_va, to_va):
 def assemble(source, va, symbols, workdir):
     asm, obj, elf, binary = (workdir / name for name in ('cave.S', 'cave.o', 'cave.elf', 'cave.bin'))
     asm.write_text(source)
-    clang = shutil.which('clang') or '/opt/homebrew/opt/llvm/bin/clang'
+    clang = next((c for c in ('/opt/homebrew/opt/llvm/bin/clang', shutil.which('clang')) if c and Path(c).is_file()), 'clang')
     lld = shutil.which('ld.lld') or '/opt/homebrew/opt/llvm/bin/ld.lld'
     objcopy = shutil.which('llvm-objcopy') or '/opt/homebrew/opt/llvm/bin/llvm-objcopy'
     subprocess.run([clang, '--target=aarch64-none-elf', '-c', asm, '-o', obj], check=True)
@@ -395,6 +397,7 @@ def main():
         sites.append((AFTER_MMU_VA, 3, {'target': AFTER_MMU_VA + 4}))
         description = f'stage 3 reset {args.reset_delay} s after the MMU is on'
 
+    code_end = 0
     with tempfile.TemporaryDirectory() as tmp:
         for site, stage, symbols in sites:
             source = RESET_BEFORE if (stage == 4 and args.reset_before) else SOURCES[stage].format(ticks=TIMEBASE * args.reset_delay)
@@ -402,11 +405,12 @@ def main():
             if len(code) > CAVE_SIZE:
                 raise SystemExit(f'Stage {stage} code is too large')
             data[file_offset(CAVES[stage]):file_offset(CAVES[stage]) + len(code)] = code
+            code_end = max(code_end, CAVES[stage] + len(code))
     for site, stage, _ in sites:
         struct.pack_into('<I', data, file_offset(site), branch(site, CAVES[stage]))
     if args.panic_screen:
         # Right after the last probe cave in use, so the padding is shared as tightly as possible.
-        PANIC_CAVE = max(CAVES[stage] for _, stage, _ in sites) + CAVE_SIZE
+        PANIC_CAVE = (code_end + 15) & ~15
         if word(PANIC_VA) in (0, 0xFFFFFFFF) or any(data[file_offset(PANIC_CAVE):file_offset(PANIC_CAVE_END)]):
             raise SystemExit('panic() or the panic screen padding is not as expected')
         with tempfile.TemporaryDirectory() as tmp:
-- 
