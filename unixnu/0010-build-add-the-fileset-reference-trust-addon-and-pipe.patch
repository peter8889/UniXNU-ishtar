diff --git a/scripts/make-m2vpack.py b/scripts/make-m2vpack.py
new file mode 100644
index 0000000..c77c0ab
--- /dev/null
+++ b/scripts/make-m2vpack.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""Merge pipeline-cache exports (read-sheng-log.py run dirs: <run>/export/manifest.json + files/) into one SHEXP001 pack for
+make-gpu-addon.py --pipeline-pack. Later directories win on equal paths. usage: make-m2vpack.py OUT EXPORT_DIR..."""
+import json, struct, sys, zlib
+from pathlib import Path
+out, dirs = Path(sys.argv[1]), [Path(d) for d in sys.argv[2:]]
+merged, root = {}, '/'
+for d in dirs:
+    m = json.loads((d / 'manifest.json').read_text())
+    root = m['directory']
+    for f in m['files']:
+        merged[f['path']] = (f['mode'], f['uid'], f['gid'], (d / 'files' / f['path']).read_bytes())
+stream = bytearray(b'M2VCACH1' + struct.pack('<I', len(root.encode())) + root.encode() + struct.pack('<I', len(merged)))
+for path, (mode, uid, gid, data) in sorted(merged.items()):
+    pb = path.encode()
+    stream += struct.pack('<IIIIQ', len(pb), mode, uid, gid, len(data)) + pb + data
+z = zlib.compress(bytes(stream), 6)
+out.write_bytes(b'SHEXP001' + struct.pack('<II', len(stream), len(z)) + z)
+print(f'{out}: {len(merged)} files, {len(stream)} bytes, {len(z)} compressed')
diff --git a/scripts/trust-append-module.py b/scripts/trust-append-module.py
new file mode 100644
index 0000000..63d2662
--- /dev/null
+++ b/scripts/trust-append-module.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""trust-append-module.py IN OUT CDHASH [CDHASH ...]: copy a trust bundle (bundle-ipsw-trust.py layout) and append one version-2
+module with the given CDHashes (hash type 2). The IPSW modules stay byte for byte; the kernel loads the new one as an engineering module."""
+import struct
+import sys
+import uuid
+from pathlib import Path
+
+if len(sys.argv) < 4:
+    sys.exit(__doc__)
+data = Path(sys.argv[1]).read_bytes()
+count = struct.unpack_from('<I', data)[0]
+starts = list(struct.unpack_from(f'<{count}I', data, 4)) + [len(data)]
+modules = [data[starts[i]:starts[i + 1]] for i in range(count)]
+hashes = sorted({bytes.fromhex(h) for h in sys.argv[3:]})
+assert all(len(h) == 20 for h in hashes), 'CDHashes are 20 bytes'
+ident = uuid.uuid5(uuid.NAMESPACE_URL, 'org.unixnu.owner:' + ''.join(h.hex() for h in hashes)).bytes
+modules.append(struct.pack('<I16sI', 2, ident, len(hashes)) + b''.join(h + bytes([2, 0, 0, 0]) for h in hashes))
+cursor, offsets = 4 + 4 * len(modules), []
+for m in modules:
+    offsets.append(cursor)
+    cursor += len(m)
+Path(sys.argv[2]).write_bytes(struct.pack(f'<{len(modules) + 1}I', len(modules), *offsets) + b''.join(modules))
+print(f'{sys.argv[2]}: {count} -> {len(modules)} modules, last has {len(hashes)} hashes')
diff --git a/scripts/turnip-kmd-patch.py b/scripts/turnip-kmd-patch.py
new file mode 100644
index 0000000..ecfb156
--- /dev/null
+++ b/scripts/turnip-kmd-patch.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+"""Edit the new-file hunk of turnip-darwin-kmd.patch as a real file: `extract OUT.cc` and `inject IN.cc` (rewrites the hunk header)."""
+import re, sys
+from pathlib import Path
+PATCH = str(Path(__file__).resolve().parents[1] / 'patches/mesa/turnip-darwin-kmd.patch')
+HEAD = 'diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc\n'
+p = open(PATCH).read()
+a = p.index(HEAD)
+m = re.search(r'^@@ -0,0 \+1,(\d+) @@\n', p[a:], re.M)
+start = a + m.end()
+n = int(m.group(1))
+lines = p[start:].split('\n')
+body = lines[:n]
+assert all(l.startswith('+') for l in body)
+rest_start = start + sum(len(l) + 1 for l in body)
+if sys.argv[1] == 'extract':
+    open(sys.argv[2], 'w').write('\n'.join(l[1:] for l in body) + '\n')
+else:
+    text = open(sys.argv[2]).read().rstrip('\n').split('\n')
+    new = ''.join('+' + l + '\n' for l in text)
+    out = p[:a + m.start()] + '@@ -0,0 +1,%d @@\n' % len(text) + new + p[rest_start:]
+    open(PATCH, 'w').write(out)
