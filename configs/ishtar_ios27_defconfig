# Stage 0 (iOS 27 bring-up): kernel, UFS root and owner storage chain from sheng's iPadOS 27 defconfig.
# Display binding (CONFIG_XNU_NATIVE_LEGACY_DISPLAY) and the A740 (CONFIG_XNU_NATIVE_ADRENO) stay off until their
# iPhone17,2 ABI records exist: the sheng/UniXNU records hold iPad17,3 kernelcache addresses (porting.toml image-assembly).
CONFIG_XNU_BUILD_ARCHIVES=1
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_DT_PANIC_REGION=1
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sheng-source-storage/libShengSourceStorage.a -Wl,-force_load,/home/builder/hackios-ishtar/stage0-stubs/libstage0stubs.a"
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=1
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"
CONFIG_XNU_SOURCE_STORAGE=1
CONFIG_XNU_OWNER_ROOT_AUDIT=1
CONFIG_XNU_OWNER_ROOT_TRUST=1
CONFIG_XNU_NATIVE_RAM_BLOCK=1
CONFIG_XNU_OWNER_CACHE_MOUNT=1
CONFIG_XNU_OWNER_CACHE_STARTUP=1
CONFIG_XNU_OWNER_BOOT_MANIFEST=1
CONFIG_XNU_OWNER_DATA_MOUNT=1
CONFIG_XNU_OWNER_UNION_SYSTEMOS=1
# REQUIRED: APFS volume UUID of ishtar's Data seed, read after it is created (sheng's is 2A5E9027-D9E1-40F9-983C-41BD3F1994F5).
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="5554FB06-852B-4426-A371-6FA199F0FE3C"
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=1
CONFIG_XNU_NATIVE_ADRENO=n
