diff --git a/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/IshtarSpmiKeys.h b/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/IshtarSpmiKeys.h
new file mode 100644
index 00000000..90685faa
--- /dev/null
+++ b/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/IshtarSpmiKeys.h
@@ -0,0 +1,119 @@
+/** @file
+  Hardware keys of the Xiaomi Pad 6S Pro through the SPMI PMIC arbiter, as pure register-pointer code (host-testable).
+
+  Facts, all from the board devicetree and mainline Linux (drivers/input/misc/pm8941-pwrkey.c, drivers/pinctrl/qcom/pinctrl-spmi-gpio.c):
+    power key   PMIC SID 0, PON peripheral PID 0x13 (reg 0x1300), PON_RT_STS at +0x10, PON_GEN3_KPDPWR_N_SET = bit 7, set = pressed
+    volume down PMIC SID 0, same register, PON_GEN3_RESIN_N_SET = bit 6, set = pressed (the board's linux,code 114)
+    volume up   PM8550 (SID 1) GPIO6, peripheral PID 0x88 + 5 = 0x8d, RT_STS at +0x10 bit 0; gpio-keys flags 1 = active low
+  The arbiter layout (version 7, "core" 0xc400000, "cnfg" 0xc42d000, "obsrvr" 0xc440000, EE 0) is the one the kernel side already reads
+  on this hardware (BootResetCore.h): an APID is found by its PPID (SID << 8 | PID) in the APID map, and a register byte is read with an
+  extended-read command on the observer channel of that APID.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef ISHTAR_SPMI_KEYS_H_
+#define ISHTAR_SPMI_KEYS_H_
+
+#include <stdint.h>
+
+enum {
+  SK_VERSION_V7_MIN = 0x70000000u, SK_VERSION_V8_MIN = 0x80000000u,
+  SK_FEATURES = 0x04, SK_FEATURES_APIDS_MASK = 0x7ffu,
+  SK_APID_MAP = 0x2000,
+  SK_OBS_EE_STRIDE = 0x8000, SK_OBS_APID_STRIDE = 0x20,
+  SK_CMD = 0x00, SK_STATUS = 0x08, SK_RDATA0 = 0x18,
+  SK_OP_EXT_READL = 1,
+  SK_STATUS_DONE = 1u << 0, SK_STATUS_ERRORS = 0xeu,
+  SK_POLLS = 100000,
+  SK_PPID_PON = 0x013, SK_PPID_GPIO6 = 0x18d, SK_REG_RT_STS = 0x10,
+  SK_PON_RESIN = 1u << 6, SK_PON_KPDPWR = 1u << 7,
+  SK_KEY_POWER = 1u << 0, SK_KEY_VOLDOWN = 1u << 1, SK_KEY_VOLUP = 1u << 2
+};
+
+struct sk_arbiter {
+  volatile uint32_t *core;   // 0x3000 bytes
+  volatile uint32_t *obs;    // observer channels of this EE and above (EE 0 starts at the base)
+  uint8_t ee;
+};
+
+// 0 and *apid on success. 1 unknown layout, 2 no APIDs, 3 PPID not mapped.
+static inline int sk_find_apid (const struct sk_arbiter *a, uint32_t ppid, int *apid)
+{
+  uint32_t version = a->core[0], apids = a->core[SK_FEATURES / 4] & SK_FEATURES_APIDS_MASK;
+  *apid = -1;
+  if (version < SK_VERSION_V7_MIN || version >= SK_VERSION_V8_MIN) return 1;
+  if (!apids || apids > 1024) return 2;
+  for (uint32_t i = 0; i < apids; ++i) {
+    uint32_t map = a->core[(SK_APID_MAP + 4 * i) / 4];
+    if (map && ((map >> 8) & 0xfff) == ppid) { *apid = (int) i; break; }
+  }
+  return *apid < 0 ? 3 : 0;
+}
+
+// One register byte through the observer channel. 0 ok, 1 timeout, 2 the arbiter reported an error.
+static inline int sk_read8 (const struct sk_arbiter *a, int apid, uint8_t reg, uint8_t *value)
+{
+  volatile uint32_t *ch = a->obs + (SK_OBS_EE_STRIDE * a->ee + SK_OBS_APID_STRIDE * (uint32_t) apid) / 4;
+  ch[SK_CMD / 4] = ((uint32_t) SK_OP_EXT_READL << 27) | ((uint32_t) reg << 4);
+  for (unsigned n = 0; n < SK_POLLS; ++n) {
+    uint32_t s = ch[SK_STATUS / 4];
+    if (s & SK_STATUS_DONE) {
+      if (s & SK_STATUS_ERRORS) return 2;
+      *value = (uint8_t) ch[SK_RDATA0 / 4];
+      return 0;
+    }
+  }
+  return 1;
+}
+
+struct sk_keys { int pon, gpio; };   // APIDs, -1 = not available
+
+static inline int sk_open (const struct sk_arbiter *a, struct sk_keys *k)
+{
+  int rc = sk_find_apid (a, SK_PPID_PON, &k->pon);
+  if (rc) return rc;
+  if (sk_find_apid (a, SK_PPID_GPIO6, &k->gpio)) k->gpio = -1;   // the power and volume-down keys still work without it
+  return 0;
+}
+
+// Pressed keys as SK_KEY_* bits. 0 ok; non-zero when a read failed (nothing is reported pressed then).
+static inline int sk_sample (const struct sk_arbiter *a, const struct sk_keys *k, uint8_t *pressed)
+{
+  uint8_t v = 0;
+  *pressed = 0;
+  int rc = sk_read8 (a, k->pon, SK_REG_RT_STS, &v);
+  if (rc) return rc;
+  if (v & SK_PON_KPDPWR) *pressed |= SK_KEY_POWER;
+  if (v & SK_PON_RESIN) *pressed |= SK_KEY_VOLDOWN;
+  if (k->gpio >= 0) {
+    rc = sk_read8 (a, k->gpio, SK_REG_RT_STS, &v);
+    if (rc) { *pressed = 0; return rc; }
+    if (!(v & 1)) *pressed |= SK_KEY_VOLUP;       // active low
+  }
+  return 0;
+}
+
+// Debounce and auto-repeat. A key counts as pressed after two identical samples. Volume keys repeat while held: first after
+// `delay` polls, then every `period` polls. step() returns the keys to report now (new presses plus repeats).
+struct sk_filter { uint8_t last, stable; uint16_t held[3]; };
+
+static inline uint8_t sk_step (struct sk_filter *f, uint8_t sample, uint16_t delay, uint16_t period)
+{
+  uint8_t out = 0;
+  if (sample == f->last) {
+    uint8_t fresh = (uint8_t) (sample & ~f->stable);
+    f->stable = sample;
+    out = fresh;
+    for (unsigned i = 0; i < 3; ++i) {
+      uint8_t bit = (uint8_t) (1u << i);
+      if (!(sample & bit)) { f->held[i] = 0; continue; }
+      if (fresh & bit) { f->held[i] = 0; continue; }
+      ++f->held[i];
+      if (bit != SK_KEY_POWER && f->held[i] >= delay && (f->held[i] - delay) % period == 0) out |= bit;
+    }
+  }
+  f->last = sample;
+  return out;
+}
+
+#endif
diff --git a/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/Test/keys_host.c b/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/Test/keys_host.c
new file mode 100644
index 00000000..f70ebfd5
--- /dev/null
+++ b/Platforms/Xiaomi/ishtarPkg/Drivers/IshtarKeyInputDxe/Test/keys_host.c
@@ -0,0 +1,97 @@
+// Host test of IshtarSpmiKeys.h against a software model of the arbiter's observer channels.
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include "../IshtarSpmiKeys.h"
+
+static volatile uint32_t core[0x3000 / 4];
+static volatile uint32_t obs[0x8000 / 4];
+static volatile int stop, fail;
+static uint8_t pon_sts, gpio_sts;
+static int pon_apid = 9, gpio_apid = 21;
+
+static void *device (void *arg)
+{
+  (void) arg;
+  uint32_t seen[64] = {0};
+  while (!stop) {
+    for (int apid = 0; apid < 64; ++apid) {
+      volatile uint32_t *ch = &obs[(SK_OBS_APID_STRIDE * apid) / 4];
+      uint32_t cmd = ch[SK_CMD / 4];
+      if (!cmd) { seen[apid] = 0; continue; }
+      if (cmd == seen[apid]) continue;
+      seen[apid] = cmd;
+      assert ((cmd >> 27) == SK_OP_EXT_READL && ((cmd >> 4) & 0xff) == SK_REG_RT_STS && (cmd & 7) == 0);
+      if (fail) { ch[SK_STATUS / 4] = SK_STATUS_DONE | 2; }
+      else {
+        ch[SK_RDATA0 / 4] = apid == pon_apid ? pon_sts : apid == gpio_apid ? gpio_sts : 0xee;
+        ch[SK_STATUS / 4] = SK_STATUS_DONE;
+      }
+    }
+    usleep (20);
+  }
+  return NULL;
+}
+// A new command for the same register must re-arm the model: clear the channel between reads.
+static void rearm (void) { for (int a = 0; a < 64; ++a) { obs[(SK_OBS_APID_STRIDE * a) / 4 + 2] = 0; obs[(SK_OBS_APID_STRIDE * a) / 4] = 0; } usleep (2000); }   /* the model sees the idle channel before the next command */
+
+int main (void)
+{
+  pthread_t t;
+  struct sk_arbiter arb = { core, obs, 0 };
+  struct sk_keys k;
+  uint8_t pressed;
+  int apid;
+
+  core[0] = 0x70000000u; core[SK_FEATURES / 4] = 40;
+  core[(SK_APID_MAP + 4 * 3) / 4] = (0x070u << 8) | 1;
+  core[(SK_APID_MAP + 4 * pon_apid) / 4] = (SK_PPID_PON << 8) | 1;
+  core[(SK_APID_MAP + 4 * gpio_apid) / 4] = ((uint32_t) SK_PPID_GPIO6 << 8) | 1;
+  assert (sk_find_apid (&arb, SK_PPID_PON, &apid) == 0 && apid == pon_apid);
+  assert (sk_find_apid (&arb, 0x555, &apid) == 3 && apid == -1);
+  core[0] = 0x60000000u; assert (sk_find_apid (&arb, SK_PPID_PON, &apid) == 1);
+  core[0] = 0x80000000u; assert (sk_find_apid (&arb, SK_PPID_PON, &apid) == 1);
+  core[0] = 0x70000000u; core[SK_FEATURES / 4] = 0; assert (sk_find_apid (&arb, SK_PPID_PON, &apid) == 2);
+  core[SK_FEATURES / 4] = 40;
+  assert (sk_open (&arb, &k) == 0 && k.pon == pon_apid && k.gpio == gpio_apid);
+
+  assert (pthread_create (&t, NULL, device, NULL) == 0);
+  struct { uint8_t pon, gpio, want; } cases[] = {
+    {0x00, 0x01, 0},                                   // nothing pressed (gpio high = released)
+    {0x80, 0x01, SK_KEY_POWER}, {0x40, 0x01, SK_KEY_VOLDOWN}, {0xc0, 0x01, SK_KEY_POWER | SK_KEY_VOLDOWN},
+    {0x00, 0x00, SK_KEY_VOLUP},                        // gpio low = pressed
+    {0x3f, 0x01, 0},                                   // other PON status bits are not keys
+    {0x80, 0x00, SK_KEY_POWER | SK_KEY_VOLUP},
+  };
+  for (unsigned i = 0; i < sizeof cases / sizeof *cases; ++i) {
+    rearm (); pon_sts = cases[i].pon; gpio_sts = cases[i].gpio; fail = 0;
+    int rc = sk_sample (&arb, &k, &pressed);
+    if (rc || pressed != cases[i].want) fprintf (stderr, "case %u rc=%d got=%x want=%x\n", i, rc, pressed, cases[i].want);
+    assert (rc == 0 && pressed == cases[i].want);
+  }
+  rearm (); fail = 1; assert (sk_sample (&arb, &k, &pressed) != 0 && pressed == 0);
+  fail = 0;
+  struct sk_keys nogpio = { pon_apid, -1 };
+  rearm (); pon_sts = 0x80; gpio_sts = 0; assert (sk_sample (&arb, &nogpio, &pressed) == 0 && pressed == SK_KEY_POWER);
+  stop = 1; pthread_join (t, NULL);
+
+  // Debounce and repeat: two identical samples make a press; volume keys repeat after `delay` polls, then every `period`; power never.
+  struct sk_filter f = {0};
+  assert (sk_step (&f, SK_KEY_VOLUP, 4, 2) == 0);                       // first sample alone: not yet
+  assert (sk_step (&f, SK_KEY_VOLUP, 4, 2) == SK_KEY_VOLUP);            // confirmed
+  unsigned repeats = 0, polls = 0;
+  for (; polls < 12; ++polls) repeats += sk_step (&f, SK_KEY_VOLUP, 4, 2) == SK_KEY_VOLUP;
+  assert (repeats == 5);                                               // at held = 4, 6, 8, 10, 12
+  assert (sk_step (&f, 0, 4, 2) == 0 && sk_step (&f, 0, 4, 2) == 0);   // release
+  assert (sk_step (&f, SK_KEY_VOLDOWN, 4, 2) == 0 && sk_step (&f, SK_KEY_VOLDOWN, 4, 2) == SK_KEY_VOLDOWN);
+  assert (sk_step (&f, SK_KEY_VOLDOWN, 4, 2) == 0);                    // a glitch of one sample is ignored below
+  f = (struct sk_filter){0};
+  assert (sk_step (&f, SK_KEY_POWER, 4, 2) == 0 && sk_step (&f, SK_KEY_POWER, 4, 2) == SK_KEY_POWER);
+  for (unsigned i = 0; i < 40; ++i) assert (sk_step (&f, SK_KEY_POWER, 4, 2) == 0);   // power does not repeat
+  f = (struct sk_filter){0};
+  assert (sk_step (&f, SK_KEY_VOLUP, 4, 2) == 0 && sk_step (&f, 0, 4, 2) == 0 && sk_step (&f, SK_KEY_VOLUP, 4, 2) == 0);   // bounce: no press
+  puts ("PASS: arbiter lookup, key decoding, read errors, debounce, repeat");
+  return 0;
+}
